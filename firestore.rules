rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 2. Member Learning Records (각 회원의 학습 이력)
    match /learning_records/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Validation helper for Study Summary posts
    function isValidSummary(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 100000
        && data.sectionId is string && data.sectionId.size() <= 100
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.createdAt is number;
    }

    // Validation helper for Comments
    function isValidComment(data, summaryId) {
      return data.content is string && data.content.size() > 0 && data.content.size() <= 4000
        && data.summaryId is string && data.summaryId == summaryId
        && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.createdAt is number;
    }

    // 3. Study Summaries (학습 정리) - Shared community learning notes
    match /study_summaries/{summaryId} {
      allow get, list: if true;

      allow create: if isValidId(summaryId)
        && isValidSummary(incoming());

      allow update: if isValidId(summaryId)
        && isValidSummary(incoming());

      allow delete: if isValidId(summaryId);

      // 4. Comments on Study Summaries (학습 정리 댓글)
      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if isValidId(summaryId)
          && isValidId(commentId)
          && isValidComment(incoming(), summaryId);

        allow update, delete: if isValidId(summaryId)
          && isValidId(commentId);
      }
    }
  }
}

{
  "entities": {
    "StudySummary": {
      "title": "StudySummary",
      "description": "Student self-directed study summary post for a specific science textbook section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionId": { "type": "string" },
        "sectionTitleKo": { "type": "string" },
        "sectionTitleEn": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "likes": { "type": "number" }
      },
      "required": ["id", "sectionId", "title", "content", "authorId", "authorName", "createdAt"]
    },
    "SummaryComment": {
      "title": "SummaryComment",
      "description": "Feedback or comment left on a study summary post by a classmate or parent signed in with Google",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "summaryId": { "type": "string" },
        "sectionId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorRole": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "summaryId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/study_summaries/{summaryId}": {
      "schema": "StudySummary",
      "description": "Publicly readable study summaries posted by signed-in students"
    },
    "/study_summaries/{summaryId}/comments/{commentId}": {
      "schema": "SummaryComment",
      "description": "Publicly readable comments attached to a study summary, writable by signed-in users"
    }
  }
}

{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered member profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "schoolGrade": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "LearningRecord": {
      "title": "LearningRecord",
      "description": "Comprehensive study progress and history per registered member",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "completedSectionIds": { "type": "string" },
        "visitHistory": { "type": "string" },
        "quizScores": { "type": "string" },
        "customVocabulary": { "type": "string" },
        "textHighlights": { "type": "string" },
        "lastSyncedAt": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "displayName", "updatedAt"]
    },
    "StudySummary": {
      "title": "StudySummary",
      "description": "Member self-directed study summary post for a specific science textbook section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sectionId": { "type": "string" },
        "sectionTitleKo": { "type": "string" },
        "sectionTitleEn": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageCaption": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "likes": { "type": "number" }
      },
      "required": ["id", "sectionId", "title", "content", "authorId", "authorName", "createdAt"]
    },
    "SummaryComment": {
      "title": "SummaryComment",
      "description": "Feedback or comment left on a study summary post by a registered member or parent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "summaryId": { "type": "string" },
        "sectionId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorRole": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "summaryId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Member user profile documents"
    },
    "/learning_records/{userId}": {
      "schema": "LearningRecord",
      "description": "Learning progress and study records stored per member"
    },
    "/study_summaries/{summaryId}": {
      "schema": "StudySummary",
      "description": "Shared study summaries created by registered members"
    },
    "/study_summaries/{summaryId}/comments/{commentId}": {
      "schema": "SummaryComment",
      "description": "Comments left on study summaries by registered members"
    }
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional environment overrides)
# When deploying to production or hosting on Vercel/Netlify/Cloud Run,
# you can provide these environment variables instead of committing firebase-applet-config.json.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_PROJECT_ID="primeval-falcon-387715"
VITE_FIREBASE_APP_ID="1:195664391315:web:..."
VITE_FIREBASE_AUTH_DOMAIN="primeval-falcon-387715.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="primeval-falcon-387715.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="195664391315"
VITE_FIREBASE_OAUTH_CLIENT_ID="195664391315-...apps.googleusercontent.com"
